{
  "permissions": {
    "allow": [
      "Bash(python3 .claude/skills/line-stamp-generator/scripts/*)",
      "Bash(python .claude/skills/line-stamp-generator/scripts/*)",
      "Bash(pip install -r requirements.txt*)",
      "Bash(unzip -l *)",
      "Bash(ls *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(bash scripts/check-refs.sh)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.claude/settings.local.json)",
      "Bash(rm -r projects*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous.py",
            "statusMessage": "破壊的コマンドを検査中"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-submit.py",
            "statusMessage": "不可逆操作を検査中"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate-reminder.sh"
          }
        ]
      }
    ]
  }
}
